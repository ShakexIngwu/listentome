# =============================================================================
# .env.example — Copy to .env and fill in your values.
# The backend docker-compose service automatically overrides POSTGRES_URL
# with the Docker internal hostname (postgres:5432), so only set this for
# local (non-Docker) development.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Local dev only — docker-compose overrides this with postgres:5432 internally
POSTGRES_URL=postgresql+asyncpg://buffett:buffett@localhost:5432/stocks
POSTGRES_PASSWORD=buffett          # Also used by docker-compose postgres service
POSTGRES_BACKUP_DIR=./backups
POSTGRES_BACKUP_KEEP_DAYS=30

# ── DuckDB ────────────────────────────────────────────────────────────────────
DUCKDB_PATH=./analytics/stocks_analytics.duckdb
PARQUET_DIR=./analytics/parquet

# ── NASDAQ ingestion ──────────────────────────────────────────────────────────
NASDAQ_URL=https://api.nasdaq.com/api/screener/stocks?tableonly=true&limit=10000&exchange=NASDAQ&download=true
WORKER_CONCURRENCY=10
RATE_LIMIT_RPS=3.0
YFINANCE_RETRY_ATTEMPTS=3

# ── Google ADK / Gemini ───────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash-preview-04-17

# ── Analysis Strategy ─────────────────────────────────────────────────────────
# Available strategies: early_buffett (more coming soon)
ANALYSIS_STRATEGY=early_buffett
# Number of top pre-scored candidates to send to the LLM stage
LLM_TOP_N=50

# ── Scheduler ─────────────────────────────────────────────────────────────────
WEEKLY_RUN_DAY=sun
WEEKLY_RUN_HOUR=2
DAILY_RUN_HOUR_AM=7
DAILY_RUN_HOUR_PM=18

# ── EDGAR identity (required by SEC fair-access policy) ───────────────────────
EDGAR_USER_AGENT=BuffettScreener your@email.com

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_PORT=8501   # Host port the Streamlit UI is available at

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
